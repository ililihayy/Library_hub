DATABASE_URL=sqlite:///./library_hub.db
API_PREFIX=/api/v1
PROJECT_NAME=Library Hub API
# Required for MFA challenge tokens (use a long random string in production)
SECRET_KEY=replace-with-openssl-rand-hex-32

# MFA email confirmation (POST /auth/mfa/setup sends a 6-digit code)
MFA_EMAIL_CODE_TTL_MINUTES=15
# If true and SMTP is unset, the code is only printed in API logs (local dev)
MFA_EMAIL_LOG_CODE_IN_DEV=false

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
